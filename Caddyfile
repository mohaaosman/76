# Serves the built docs site + shadcn registry from dist/.
# Coolify's proxy terminates TLS and injects $PORT; we listen plain HTTP.
{
	admin off
	auto_https off
}

:{$PORT:3000} {
	root * dist
	encode zstd gzip
	file_server

	# The registry JSON and AI docs are consumed cross-origin by tools
	# (shadcn, CDNs, assistants) — allow reads and cache briefly.
	@public path /r/* /llms/* /llms.txt
	header @public Access-Control-Allow-Origin "*"
	header @public Cache-Control "public, max-age=300"
}
